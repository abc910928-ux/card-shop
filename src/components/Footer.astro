---
import { shop, shippingMethods } from "../config/shop";
import { feeLabel } from "../lib/shipping";
import { url } from "../lib/url";
---

<footer class="mt-16 bg-ink text-white/80">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:grid-cols-3 sm:px-6">
    <div>
      <div class="text-lg font-bold text-white">{shop.name}</div>
      <p class="mt-2 text-sm leading-relaxed text-white/60">{shop.description}</p>
    </div>

    <div class="text-sm">
      <div class="mb-3 font-medium text-white">寄送方式</div>
      <ul class="space-y-1.5 text-white/70">
        {shippingMethods.map((m) => <li>{m.short}：{feeLabel(m)}</li>)}
        <li>交貨便可選申報價值，黑貓宅配可加保</li>
      </ul>
      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
        <a href={url("/guide/")} class="text-accent hover:underline">完整購物說明 →</a>
        <a href={url("/terms/preorder/")} class="text-accent hover:underline">預購服務條款 →</a>
        <a href={url("/terms/proxy/")} class="text-accent hover:underline">代購服務條款 →</a>
        <a href={url("/terms/privacy/")} class="text-accent hover:underline">隱私權政策 →</a>
      </div>
    </div>

    <div class="flex items-start gap-4 sm:justify-end">
      <a
        href={shop.lineUrl}
        target="_blank"
        rel="noopener"
        class="shrink-0 rounded-lg bg-white p-1.5"
      >
        <img src={url(`/${shop.lineQr}`)} alt={`LINE 加好友（ID：${shop.lineId}）`} width="96" height="96" class="h-24 w-24" />
      </a>
      <div class="text-sm">
        <div class="font-medium text-white">LINE 聯絡</div>
        <div class="mt-1 text-white/60">ID：{shop.lineId}</div>
        <div class="mt-1 text-white/60">掃描或點擊加好友</div>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto max-w-7xl px-4 py-4 text-xs text-white/40 sm:px-6">
      © 2026 {shop.name}・商品圖片皆為實拍，狀況以照片為準
    </div>
  </div>
</footer>
