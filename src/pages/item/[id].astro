---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Gallery from "../../components/Gallery.astro";
import OrderPanel from "../../components/OrderPanel";
import PreorderPanel from "../../components/PreorderPanel";
import WishlistButton from "../../components/WishlistButton";
import { ProductCard } from "../../components/ProductCard";
import { getProducts, toView, type ProductEntry } from "../../lib/catalog";
import { subline } from "../../lib/format";
import { shop } from "../../config/shop";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((entry) => ({ params: { id: entry.id }, props: { entry, products } }));
}

interface Props {
  entry: ProductEntry;
  products: ProductEntry[];
}
const { entry, products } = Astro.props;
const p = await toView(entry);
const { Content } = await render(entry);

// 規格表：有填才顯示
const specs = [
  ["遊戲", p.game],
  ["系列", p.set],
  ["卡號", p.number],
  ["稀有度", p.rarity],
  ["語言", p.language],
].filter((s): s is [string, string] => !!s[1]);

// 相關商品：同系列優先，其次同遊戲
const others = products.filter((e) => e.id !== entry.id && e.data.stock > 0);
const related = await Promise.all(
  [
    ...others.filter((e) => p.set && e.data.set === p.set),
    ...others.filter((e) => e.data.game === p.game && e.data.set !== p.set),
  ]
    .slice(0, 4)
    .map(toView),
);
---

<Base title={`${p.name}${p.rarity ? ` ${p.rarity}` : ""}`} description={`${subline(p)} ${p.name}`}>
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6">
    <nav class="mb-5 flex flex-wrap gap-1 text-xs text-muted">
      <a href={url("/shop/")} class="hover:text-ink">全部商品</a>
      <span>/</span>
      <a href={url(`/shop/?category=${encodeURIComponent(p.category)}`)} class="hover:text-ink">{p.category}</a>
      <span>/</span>
      <a href={url(`/shop/?game=${encodeURIComponent(p.game)}`)} class="hover:text-ink">{p.game}</a>
    </nav>

    <div class="grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,4fr)] lg:gap-12">
      <div class="mx-auto w-full max-w-md lg:max-w-none">
        <Gallery images={entry.data.images} product={p} />
      </div>

      <div>
        {subline(p) && <div class="text-sm text-muted">{subline(p)}</div>}
        <h1 class="mt-1 text-2xl font-bold leading-snug sm:text-3xl">
          {p.name}
          {p.rarity && <span class="ml-2 text-muted">{p.rarity}</span>}
        </h1>

        <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3 border-y border-line py-4 text-sm sm:grid-cols-3">
          {
            specs.map(([k, v]) => (
              <div>
                <dt class="text-xs text-muted">{k}</dt>
                <dd class="mt-0.5 font-medium">{v}</dd>
              </div>
            ))
          }
        </dl>

        <div class="prose-sm mt-4 text-sm leading-relaxed text-ink-soft">
          <Content />
        </div>

        <div class="mt-6 space-y-3">
          {p.preorder ? <PreorderPanel client:load p={p} /> : <OrderPanel client:load p={p} />}
          <WishlistButton client:load productId={p.id} price={p.price} stock={p.stock} variant="full" />
        </div>

        <details class="mt-4 rounded-xl border border-line bg-surface p-4 text-sm">
          <summary class="cursor-pointer font-medium">購買須知</summary>
          <ul class="mt-3 list-disc space-y-1.5 pl-5 text-ink-soft">
            <li>商品圖片為實拍或官方示意圖，以商品說明為準。</li>
            <li>{shop.leadTime}。</li>
            {
              p.preorder ? (
                <li>
                  預購需登入 LINE，不收訂金；到貨通知後 3 天內付款，詳見<a href={url("/terms/preorder/")} class="underline">預購服務條款</a>。
                </li>
              ) : (
                <li>在網站結帳：選寄送方式（7-11 交貨便或黑貓宅配）與付款方式（銀行轉帳或取貨付款），送出後可在訂單頁追蹤進度。</li>
              )
            }
            <li>本店不會傳任何連結要求你「簽署金流」或「驗證帳戶」，遇到請直接封鎖。</li>
          </ul>
        </details>
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="mt-14">
          <h2 class="mb-4 text-xl font-bold">相關商品</h2>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
            {related.map((r) => (
              <ProductCard p={r} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
