---
import Base from "../../layouts/Base.astro";
import CartApp from "../../components/CartApp";
import { getProductViews } from "../../lib/catalog";

// 購物車與結帳都在這頁；商品資料在建置時傳入（價格、規格、付款方式）
const products = await getProductViews();
---

<Base title="購物車・結帳" noindex>
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <h1 class="mb-6 text-2xl font-bold">購物車・結帳</h1>
    <CartApp client:load products={products} />
  </section>
</Base>
